<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Reports</title>
    <%- include('partials/commonhead') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <h1>Report: <%=reportFriendlyName%></h1>
    <form method="POST" enctype="multipart/form-data">
        <% for(let reportField of fields) { %>
            <% if (reportField.friendlyName) { %><label><%=reportField.friendlyName%>: <% } %><input value="<%=reportField.defaultValue ?? ""%>" type="<%=reportField.type%>" name="<%=reportField.name%>"><% if (reportField.friendlyName) { %></label><% } %><br>
        <% } %>
        <button type="submit" formaction="/run-report/<%=reportName%>">Submit</button>
    </form>
</main>
</body>
</html>