<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>My Accounts</title>
    <%- include('partials/table-basedcss') %>
    <%- include('partials/commonhead') %>
</head>
<body>
<%- include('partials/header') %>
<main>

    <div class="top-container">
        <h1><%= typeof pageTitle !== "undefined" ? pageTitle : "Accounts" %></h1>
        <button class="top-end" type="button" style="font-size: 1em" popovertarget="add-popover"><strong>Add...</strong></button>
    </div>
    <h1 class="print-visible center">Account report for account <%= authenticatedUser.username %></h1>
    <% var reportTime = new Date() %>
    <h4 class="print-visible center">Accurate as of <%= reportTime.getFullYear() + "/" + (reportTime.getMonth()+1) + "/" + reportTime.getDate() + " at " + reportTime.getHours() + ":" + reportTime.getMinutes() + ":" + reportTime.getSeconds()%></h4>
    <% if (typeof aleEquation !== "undefined" && aleEquation) { %>
        <h2 style="width: max-content; margin: 0 auto;">$<%=categoryTotals.asset < 0 ? "-" : ""%><%= Math.floor(Math.abs(categoryTotals.asset) / 100) %>.<%= (Math.abs(categoryTotals.asset) % 100).toString().padStart(2, '0') %> = <%=categoryTotals.liability < 0 ? "-" : ""%>$<%= Math.floor(Math.abs(categoryTotals.liability) / 100) %>.<%= (Math.abs(categoryTotals.liability) % 100).toString().padStart(2, '0') %> <%= categoryTotals.equity + categoryTotals.revenue < categoryTotals.expense ? "-" : "+"%> $<%= Math.floor(Math.abs(categoryTotals.equity - categoryTotals.expense + categoryTotals.revenue) / 100) %>.<%= (Math.abs(categoryTotals.equity - categoryTotals.expense + categoryTotals.revenue) % 100).toString().padStart(2, '0') %></h2>
        <br>
    <% } %>
    <table class="main-table">
        <thead>
            <tr>
                <th style="width: 14ch;" class="mobile-elidable">Account Type</th>
                <th>Account Name</th>
                <th style="text-align: right; width: <%=Math.max(7, accounts.map(x=>x.balance).concat(Object.values(categoryTotals)).map(x=>Math.max(Math.floor(Math.log10(Math.abs(x))) + 1, 3) + (x < 0 ? 4 : 2)).reduce((acc, x) => x > acc ? x : acc, 0))%>ch">Balance</th>
            </tr>
        </thead>
        <tbody>
            <% if (accounts.length === 0) { %>
                <tr>
                    <td class="empty-text mobile-elidable" colspan="5"><p>No accounts found.</p></td>
                    <td class="empty-text mobile-replacement" colspan="4"><p>No accounts found.</p></td>
                </tr>
            <% } else { %>
                <% for(let i = 0; i < accounts.length; ++i){ %>
                    <% account = accounts[i] %>
                    <% if(i === 0 || accounts[i].category !== accounts[i - 1].category) { %>
                        <tr class="section-name mobile-elidable">
                            <td colspan="3">
                                <%= account.categoryString%> Accounts
                            </td>
                        </tr>
                        <tr class="section-name mobile-replacement">
                            <td colspan="2">
                                <%= account.categoryString%> Accounts
                            </td>
                        </tr>
                    <% } %>
                    <tr>
                        <td class="mobile-elidable"><%= account.categoryString %></td>
                        <td><%= account.ticker ? "STOCK: " + account.ticker : account.nickname %><%if (account.ticker) { %>, <%= account.shares %> share<%=account.shares !== 1 ? "s" : ""%> <a href="/update-stock-account/<%=account.id%>">(Update value)</a><%}%><% if (account.default_cashback_pct !== null && account.default_cashback_pct !== undefined) {%> <a href="/quick-charge/<%=account.id%>">&#9889; Quick Charge</a><% } %></td>
                        <td style="text-align: right"<% if(account.balance < 0) { %> class="negative"<% } %>><%=account.balance < 0 ? "(" : ""%>$<%= Math.floor(Math.abs(account.balance) / 100) %>.<%= (Math.abs(account.balance) % 100).toString().padStart(2, '0')%><%=account.balance < 0 ? ")" : ""%></td>
                    </tr>
                    <% if (i === accounts.length - 1 || accounts[i].category !== accounts[i + 1].category) { %>
                        <tr>
                            <td class="mobile-elidable"><strong><%= account.categoryString %></strong></td>
                            <td><strong><span class="mobile-replacement"><%= account.categoryString %> </span>Category Total</strong></td>
                            <% var categoryTotal = categoryTotals[account.categoryString.toLowerCase()]%>
                            <td style="text-align: right"><strong<% if(categoryTotal < 0) { %> class="negative"<% } %>><%=categoryTotal < 0 ? "(" : ""%>$<%= Math.floor(Math.abs(categoryTotal) / 100) %>.<%= (Math.abs(categoryTotal) % 100).toString().padStart(2, '0') %><%=categoryTotal < 0 ? ")" : ""%></strong></td>
                        </tr>
                    <% } %>
                <% } %>
            <% }%>
        </tbody>
    </table>
</main>
<div popover id="add-popover" class="top-popover">
    <a href="/add-account">Add Standard Account</a><br>
    <a href="/add-stock-account">Add Stock Account</a><br>
    <a href="/add-journal-entry">Add Journal Entry</a>
</div>
</body>
</html>
