<% if (report === null) { %>
    <span>No data to display.</span>
<% } else { %>
<svg viewBox="<%=report.width / 20%> <%=report.height / 20%> <%=9 * report.width / 10%> <%=9 * report.height / 10%>" <% if(typeof style !== "undefined"){ %> style="width: 50%; border-radius: 100%/100%; <%=style%>" <% } %>>
    <% for(let i = 0; i < report.points.length; ++i) { %>
        <%if(report.links && report.links[i]){%>
            <a href="<%=report.links[i]%>">
        <%}%>
            <polygon style="stroke: var(--theme-main-background-color);" stroke-width="0.006" fill="<%=report.colors[i]%>" points="0.5 0.5 <%=(i === 0 ? "0.5 0" : report.points[i-1].split(" ").slice(-2).join(" "))%> <%=(i === report.points.length - 1 ? report.points[i].split(' ').slice(0, -2).join(" ") + " 0.5 0" : report.points[i])%>">
                <title><%=report.names[i]%>&#xA;$<%=Math.floor(report.amounts[i]/100)%>.<%=(report.amounts[i] % 100).toString().padStart(2, '0')%></title>
            </polygon>
        <%if(report.links && report.links[i]){%>
            </a>
        <%}%>
    <% } %>
</svg>
<% if(report.key) { %>
<svg style="width: 40%; vertical-align: top;" viewBox="0 0 300 <%=report.key.length * 15 + 15%>">
    <% for (let i = 0; i < report.key.length; ++i) { %>
        <rect x="0" y="<%=i*15+3%>" width="10px" height="10px" fill="<%=report.key[i].color%>">
        </rect>
        <text style="stroke: var(--theme-main-text-color); fill: var(--theme-main-text-color);" x="12" y="<%=i*15+6+3%>" text-anchor="start" dominant-baseline="middle">
            <%=report.key[i].name%>
        </text>
    <% } %>
</svg>
<% } %>
<% } %>