<svg preserveAspectRatio="none" viewBox="0 0 <%=report.width%> <%=report.height%>" <% if(typeof style !== "undefined"){ %> style="<%=style%>" <% } %>>
    <% for(let i = 0; i <= 10; i++) { %>
        <text transform="scale(1, <%=report.height / report.width * 2%>)" stroke="black" font-size="30" x="<%=report.width / 11%>" y="<%=(((i / 10) * report.height) * 0.8 + report.height / 10) / (report.height / report.width * 2)%>" text-anchor="end" dominant-baseline="central">$<%=Math.floor((((10 - i) / 10) * report.height) / 100)%></text>
        <line vector-effect="non-scaling-stroke" x1="<%=report.width / 10%>" x2="<%=report.width * 0.9%>" y1="<%=((i / 10) * report.height) * 0.8 + report.height / 10%>" y2="<%=((i / 10) * report.height) * 0.8 + report.height / 10%>" stroke="black"></line>
    <% } %>
    <% for(let i = 0; i <= 11; ++i) { %>
         <text transform="scale(1, <%=report.height / report.width * 2%>)" stroke="black" font-size="15" x="<%=(report.width * i / 11) * 0.8 + report.width / 10%>" y="<%=((report.height * 0.95) / (report.height / report.width * 2))%>" text-anchor="middle" dominant-baseline="hanging"><%=(i + 1).toString().padStart(2, '0')%></text>
    <% } %>
    <% for(let [pointSet, setIndex] of report.pointSets.map((x, i)=>[x, i])){ %>
        <!-- <%=setIndex%> -->
        <% for(let [point, pointIndex] of pointSet.map((x, i) => [x, i])) { %>

            <% if(pointIndex !== pointSet.length - 1) { %>
            <line vector-effect="non-scaling-stroke" x1="<%=(point.x) * 0.8 + report.width / 10%>" x2="<%=(pointSet[pointIndex + 1].x) * 0.8 + report.width / 10%>" y1="<%=(report.height - point.y) * 0.8 + report.height / 10 %>" y2="<%=(report.height - pointSet[pointIndex + 1].y) * 0.8 + report.height / 10 %>" stroke-width="2" stroke="<%=report.colors[setIndex]%>"></line>
            <% } %>
            <% if(point.link) { %><a href="<%=point.link%>"><% } %>
            <ellipse rx="<%=report.width/200%>" ry="<%=report.height/100%>" cx="<%=(point.x) * 0.8 + report.width / 10%>" cy="<%=(report.height - point.y) * 0.8 + report.height / 10 %>" fill="<%=report.colors[setIndex]%>">
                <% if (point.tooltip){ %>
                    <title><%= point.tooltip %></title>
                <% } %>
            </ellipse>
            <% if(point.link) { %></a><% } %>
        <% } %>
    <% } %>
</svg>