<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Quick Charge</title>
    <%- include('partials/commonhead') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <h1>Quick Charge to <%=ccAccount.nickname%></h1>
    <% if(typeof error !== "undefined") { %>
    <div class="error-div">
        <span><%=error%></span>
    </div>
    <% } %>
    <form method="post" enctype="multipart/form-data">
        <label>Entry name:       <input type="text" name="name"<%if(typeof prefill !== "undefined" && prefill.name) { %> value="<%=prefill.name%>"<%}%>></label><br>
        <label>Transaction date: <input type="date" name="date"<%if(typeof prefill !== "undefined" && prefill.date) { %> value="<%=prefill.date%>"<%}%>></label><br>
        <label>Expense type: <%- include('partials/accountSelector.ejs', {name: 'expense_account_id', categories: ["Expense", "Asset"], selected: typeof prefill !== "undefined" && prefill['expense_account_id'] ? prefill['expense_account_id'] : undefined})%></label><br>
        <label>Credit card charge: $<input type="text" name="charge_amt"<%if(typeof prefill !== "undefined" && prefill.charge_amt) { %> value="<%=prefill.charge_amt%>"<%}%>></label><br>
        <label>Cashback account: <%- include('partials/accountSelector.ejs', {name: 'cb_account_id', categories: ["Asset"], selected: typeof prefill !== "undefined" && prefill['cb_account_id'] ? prefill['cb_account_id'] : ccAccount.default_cashback_account})%></label><br>
        <label>Cashback amount: <input type="text" name="cashback" value="<%if(typeof prefill !== "undefined" && prefill.cashback) { %><%=prefill.cashback%><%} else {%><%=((Math.floor(ccAccount.default_cashback_pct / 100)).toString() + "." + (ccAccount.default_cashback_pct % 100).toString().padStart(2, '0'))%><% } %>">%</label><br>
        <button>Generate Entry</button>
    </form>
</main>
</body>
</html>
