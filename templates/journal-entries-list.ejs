<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <title>Journal Entries</title>
    <%- include('partials/table-basedcss') %>
    <%- include('partials/commonhead') %>
    <style>
        :root {
            --w-1: 13ch;
            --w-2: 25ch;
            --w-4: 10ch;
            --w-5: 10ch;
        }
    </style>
</head>
<body>
<%- include('partials/header') %>
<main>
    <div class="top-container">
        <h1><%= pageTitle ?? "Journal Entries" %></h1>
    </div>
    <a href="/add-journal-entry">+ Add a new entry</a><br>
    <% for (let account of accounts.filter(x=>x.default_cashback_pct !== null && x.default_cashback_pct !== undefined)) { %>
        <a href="/quick-charge/<%=account.id%>">&#9889; Quick Charge "<%= account.nickname %>"</a><br>
    <% } %><br>
    <button popovertarget="entry-search">Search...</button>
    <div popover id="entry-search">
        <form action="/journal-entries-search" method="POST" enctype="multipart/form-data">
            Show entries for <label>account:
            <%-include('partials/accountSelector', {name: "account_id", placeholder: "<All Accounts>", placeholderHidden: false, accounts: accounts, selected: prefill["account_id"]})%>
            </label><br>
            <label>From: <input type="date" name="start_date" <% if(prefill !== undefined && prefill.start_date) { %> value="<%=prefill.start_date%>"<% } %>><br></label>
            <label>Up to: <input type="date" name="end_date" <% if(prefill !== undefined && prefill.end_date) { %> value="<%=prefill.end_date%>"<% } %>><br></label>
            <button>Search</button>

        </form>
    </div>
    <table class="main-table">
        <colgroup>
            <col style="width: 13ch" class="mobile-elidable">
            <col style="width: <%=Math.max(7, portions.map(x=>x.faccount_nickname).reduce((acc, x) => x.length > acc ? x.length : acc, 0))%>.5ch" class="mobile-elidable">
            <col style="width: <%=Math.max(7, portions.map(x=>x.faccount_short_name ?? x.faccount_nickname).reduce((acc, x) => x.length > acc ? x.length : acc, 0))%>.5ch" class="mobile-replacement">
            <col>
            <col style="width: <%=Math.max(5 /*len("Debit")*/, portions.filter(x=>x.amount > 0).reduce((acc, x) => acc + x.amount, 0).toString().length + 2)%>.5ch">
            <col style="width: <%=Math.max(6 /*len("Credit")*/, Math.abs(portions.filter(x=>x.amount < 0).reduce((acc, x) => acc + x.amount, 0)).toString().length + 2)%>.5ch">
        </colgroup>
        <thead>
            <tr>
                <th class="mobile-elidable">Account Type</th>
                <th>Account</th>
                <th>Description</th>
                <th>Debit</th>
                <th>Credit</th>
            </tr>
        </thead>
        <tbody>
            <tr class="print-visible">
                <td><%- new Array(13).fill("&nbsp;").join("") %></td>
                <td><%- new Array(30).fill("&nbsp;").join("") %></td>
                <td><%- new Array(40).fill("&nbsp;").join("") %></td>
                <td><%- new Array(10).fill("&nbsp;").join("") %></td>
                <td><%- new Array(10).fill("&nbsp;").join("") %></td>
            </tr>
            <% if (portions.length === 0) { %>
                <tr class="mobile-elidable">
                    <td class="empty-text" colspan="5"><p>No entries found.</p></td>
                </tr>
                <tr class="mobile-replacement">
                    <td class="empty-text" colspan="4"><p>No entries found.</p></td>
                </tr>
            <% } else { %>
                <% var totalDebit, totalCredit, total; totalDebit = 0; totalCredit = 0; total = 0; %>
                <% for(let i = 0; i < portions.length; ++i) { %>
                    <% var portion = portions[i] %>
                    <% if(i === 0 || portions[i].entry_id !== portions[i - 1].entry_id) { %>
                        <tr class="mobile-elidable section-name<% if(portion.flagged) { %> flagged<% } %>">
                            <td colspan="3"><%= portion.name %><% if(portion.for_date) { %><br><%=portion.for_date%><% } %></td>
                            <td><form method="GET" action="/edit-journal-entry/<%=portion.entry_id%>"><button>Edit</button></form></td>
                            <td><button style="text-align: center; color: #992222" popovertarget="delete-confirm-<%=portion.entry_id%>">Delete</button></td>
                        </tr>
                        <tr class="mobile-replacement section-name<% if(portion.flagged) { %> flagged<% } %>">
                            <td colspan="2"><%= portion.name %><% if(portion.for_date) { %><br><%=portion.for_date%><% } %></td>
                            <td><form method="GET" action="/edit-journal-entry/<%=portion.entry_id%>"><button style="text-align: center">Edit</button></form></td>
                            <td><button style="text-align: center; color: #992222" popovertarget="delete-confirm-<%=portion.entry_id%>">Delete</button></td>
                        </tr>
                    <% } %>
                    <tr>
                        <td class="mobile-elidable"><%= portion.faccount_category_string %></td>
                        <td><span class="mobile-elidable"><%= portion.faccount_nickname %></span><span class="mobile-replacement"><%= portion.faccount_short_name ?? portion.faccount_nickname %></span></td>
                        <td><%= portion.description.substring(0, 17) %><% if(portion.description.length > 17) { %><span class="mobile-replacement">...</span><span class="mobile-elidable"><%=portion.description.substring(17)%></span><% } %></td>
                        <td><% if (portion.amount > 0) { totalDebit += portion.amount; total += portion.amount; %>$<%=Math.floor(portion.amount / 100)%>.<%=(portion.amount % 100).toString().padStart(2, '0')%><% } %></td>
                        <td><% if (portion.amount < 0) { totalCredit -= portion.amount; total += portion.amount; %>$<%=Math.floor(-portion.amount / 100)%>.<%=(-portion.amount % 100).toString().padStart(2, '0')%><% } %></td>
                    </tr>
                <% } %>
                <%if (typeof showTotals === 'boolean' && showTotals) { %>
                    <tr class="section-name">
                        <td colspan="3" class="mobile-elidable"><strong>Total Debits: </strong></td>
                        <td colspan="2" class="mobile-replacement"><strong>Total Debits: </strong></td>
                        <td><strong>$<%=Math.floor(totalDebit / 100)%>.<%=(totalDebit % 100).toString().padStart(2, '0')%></strong></td>
                        <td></td>
                    </tr>
                    <tr class="section-name">
                        <td colspan="4" class="mobile-elidable"><strong>Total Credits: </strong></td>
                        <td colspan="3" class="mobile-replacement"><strong>Total Credits: </strong></td>
                        <td><strong>$<%=Math.floor(totalCredit / 100)%>.<%=(totalCredit % 100).toString().padStart(2, '0')%></strong></td>
                    </tr>
                    <tr class="section-name">
                        <td class="mobile-elidable" colspan="<%= total < 0 ? '4' : '3' %>"><strong>Total Balance: </strong></td>
                        <td class="mobile-replacement" colspan="<%= total < 0 ? '3' : '2' %>"><strong>Total Balance: </strong></td>
                        <td colspan="<%= total < 0 ? '1' : '2' %>"><strong>$<%=Math.floor(Math.abs(total) / 100)%>.<%=(Math.abs(total) % 100).toString().padStart(2, '0')%></strong></td>
                    </tr>
                <% } %>
            <% } %>

        </tbody>
    </table>
    <% for(let i = 0; i < portions.length; ++i){ %>
        <div popover id="delete-confirm-<%=portions[i].entry_id%>">
            <h3>Delete "<%=portions[i].name%>"?</h3>
            <form method="POST" action="/delete-journal-entry/<%=portions[i].entry_id%>" style="display: inline-block"><button style="background-color: #FF8888">Delete</button></form>
            <button popovertargetaction="hide" popovertarget="delete-confirm-<%=portions[i].entry_id%>">Cancel</button>
        </div>
    <% } %>
</main>

</body>
</html>
