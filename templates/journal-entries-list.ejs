<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Journal Entries</title>
    <%- include('partials/commonhead') %>
    <%- include('partials/table-basedcss') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <div class="top-container">
        <h1><%= pageTitle ?? "Journal Entries" %></h1>
    </div>
    <a href="/add-journal-entry">+ Add a new entry</a><br><br>
    <table class="main-table">
        <thead>
            <tr>
                <th style="width: 13ch" class="mobile-elidable">Account Type</th>
                <th style="width: 25ch">Account</th>
                <th style="width: 100%; min-width: 20ch">Description</th>
                <th style="width: 10ch">Debit</th>
                <th style="width: 10ch">Credit</th>
            </tr>
        </thead>
        <tbody>
            <% if (portions.length === 0) { %>
                <tr>
                    <td class="empty-text" colspan="5"><p>No entries found.</p></td>
                </tr>
            <% } else { %>
                <% for(let i = 0; i < portions.length; ++i) { %>
                    <% var portion = portions[i] %>
                    <% if(i === 0 || portions[i].id !== portions[i - 1].id) { %>
                        <tr class="section-name">
                            <td colspan="6" ><%= portion.name %><% if(portion.for_date) { %><br><%=portion.for_date%><% } %></td>
                        </tr>
                    <% } %>
                    <tr>
                        <td class="mobile-elidable"><%= portion.faccount_category_string %></td>
                        <td><%= portion.faccount_nickname %></td>
                        <td><%= portion.description.substring(0, 17) %><% if(portion.description.length > 17) { %><span class="mobile-replacement">...</span><% } %><span class="mobile-elidable"><%=portion.description.substring(17)%></span></td>
                        <td><% if (portion.amount > 0) { %> $<%=Math.floor(portion.amount / 100)%>.<%=(portion.amount % 100).toString().padStart(2, '0')%> <% } %></td>
                        <td><% if (portion.amount < 0) { %> $<%=Math.floor(-portion.amount / 100)%>.<%=(-portion.amount % 100).toString().padStart(2, '0')%> <% } %></td>
                    </tr>
                <% } %>
            <% } %>
        </tbody>
    </table>
</main>

</body>
</html>