<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Add a Journal Entry</title>
    <%- include('partials/commonhead') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <h1>Add a Journal Entry</h1>
    <% if(typeof error !== "undefined") { %>
        <div class="error-div">
            <span><%=error%></span>
        </div>
    <% } %>
    <form method="POST" enctype="multipart/form-data">
        <input type="hidden" name="rowCount" value="<%= rowCount %>">
        <label>Entry name: <input style="width: 50ch" type="text" name="journal_entry_name"<% if(prefill && prefill.journal_entry_name) { %> value="<%=prefill.journal_entry_name%>"<% } %>></label><br>
        <label>Entry date: <input type="date" name="journal_entry_date" value="<%if(prefill && prefill.journal_entry_date) { %><%=prefill.journal_entry_date%><% } %>"></label><br>
        <label>Flagged? <input type="checkbox" value="" name="flagged"></label>
        <table class="mobile-elidable">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Account</th>
                    <th>Debit</th>
                    <th>Credit</th>
                </tr>
            </thead>
            <tbody>
                <% for(let i = 0; i < rowCount; ++i) { %>
                    <tr>
                        <td><label><input type="text" name="description_<%= i %>"<%if(prefill && prefill["description_" + i]) { %> value="<%=prefill["description_" + i]%>"<% } %>></label></td>
                        <td><label><%- include('partials/accountSelector', {name: "account_id_" + i, accounts: accounts, selected: prefill["account_id_" + i]}) %></label></td>
                        <td><label>$<input type="text" name="debit_<%= i %>"<%if(prefill && prefill["debit_" + i]?.length) { %> value="<%=prefill["debit_" + i]%>"<% }%>></label></td>
                        <td><label>$<input type="text" name="credit_<%= i %>"<%if(prefill && prefill["credit_" + i]?.length) { %> value="<%=prefill["credit_" + i]%>"<% }%>></label></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <table class="mobile-replacement">
            <thead>
                <tr>
                    <th>Transactions</th>
                </tr>
            </thead>
            <tbody>
                <% for(let i = 0; i < rowCount; ++i) { %>
                    <tr class="mobile-replacement">
                        <td><label><input type="text" placeholder="Description..." name="m_description_<%= i %>"<%if(prefill && prefill["m_description_" + i]) { %> value="<%=prefill["m_description_" + i]%>"<% } %>></label><br>
                            <label><%- include('partials/accountSelector', {name: "m_account_id_" + i, accounts: accounts, selected: prefill["m_account_id_" + i]}) %></label><br>
                            <label><select name="d/c_<%= i %>"><option value="d">Debit</option><option value="c">Credit</option></select></label>
                            <label>$<input type="text" name="amount_<%= i %>"<%if(prefill && prefill["amount_" + i]?.length) { %> value="<%=prefill["amount_" + i]%>"<% }%>></label><br><br>
                        </td>
                    </tr>
                <% }%>
            </tbody>
        </table>
        <button formaction="/add-journal-entry">+ Add Row</button><br><br>
        <button formaction="/add-journal-entry-submit" class="mobile-elidable"><strong>Submit Entry</strong></button>
        <button formaction="/add-journal-entry-submit-mobile" class="mobile-replacement"><strong>Submit Entry</strong></button>
    </form>
</main>
</body>
</html>