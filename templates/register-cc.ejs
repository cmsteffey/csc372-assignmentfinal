<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Credit Card Registration</title>
    <%- include('partials/commonhead') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <h2>Credit Card Registration</h2>
    <form action="/register-cc" method="post" enctype="multipart/form-data">
        <label>Liability account: <%- include('partials/accountSelector', {categories: ['Liability'], name: 'faccount_id'}) %></label><br>
        <label>Cashback percentage: <input type="text" name="cashback"></label><br>
        <label>Cashback account: <%- include('partials/accountSelector', {categories: ['Asset'], name: 'cb_account_id'}) %></label><br>
        <button>Register</button>
    </form>
</main>
</body>
</html>
