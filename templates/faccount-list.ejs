<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Document</title>
    <%- include('partials/commoncss') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <h1><%= pageTitle ?? "Accounts" %></h1>
    <table>
        <thead>
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Type
                </th>
                <th>
                    Current Balance
                </th>
            </tr>
        </thead>
        <tbody>
            <% for(let account of accounts){ %>
                <tr>
                    <td>
                        <%= account.name %>
                    </td>
                    <td>
                        <%= account.categoryString %>
                    </td>
                    <td>
                        <%= account.balance %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>
</body>
</html>