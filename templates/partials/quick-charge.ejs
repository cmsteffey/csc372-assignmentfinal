<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Quick Charge</title>
    <%- include('partials/commonhead') %>
</head>
<body>
<%- include('partials/header') %>
<main>
    <h2>Quick Charge to <%=account.nickname%></h2>
    <form action="/quick-charge/<%=account.id%>" method="post" enctype="multipart/form-data">
        <label><%- include('partials/accountSelector.ejs', {name: 'faccount_id', category: "Expense"})%></label>
        <label>Credit Card Charge: $<input type="text" name="charge_amt"></label>
        <button>Generate Entry</button>
    </form>
</main>
</body>
</html>