<select name="<%=name%>">
    <option value="" <% if(typeof placeholderHidden !== 'boolean' || placeholderHidden) { %>hidden disabled <% } %> selected><%=typeof placeholder === 'string' ? placeholder : "Pick account..."%></option>
    <% var accountsSubset = accounts.filter(x=>typeof categories === 'undefined' || categories.includes(x.categoryString))%>
    <% for(let j = 0; j < accountsSubset.length; ++j) { %>
        <% if(j === 0 || accountsSubset[j].category !== accountsSubset[j-1].category) {%>
        <optgroup label="<%= accountsSubset[j].categoryString %>">
            <% } %>
            <option value="<%= accountsSubset[j].id %>"<%if(selected && selected == accountsSubset[j].id.toString()){%> selected<%}%>><%= accountsSubset[j].nickname %></option>
            <% if(j === accountsSubset.length - 1 || accountsSubset[j].category !== accountsSubset[j+1].category) { %>
        </optgroup>
        <% } %>
    <% } %>
</select>
